PORT=5008
DATA_DIR=/data
TZ=Asia/Singapore

# Internal Docker URL for jhonderson/actual-http-api
ACTUAL_API_URL=http://actual_http_api:5007
ACTUAL_API_KEY=replace-with-your-actual-http-api-key
# Optional: leave blank to auto-select your first budget or choose in Settings
ACTUAL_BUDGET_SYNC_ID=

# Default display currency
BASE_CURRENCY=SGD

# Public HTTPS origin (e.g. https://budget.yourdomain.com) - used for WebAuthn Passkeys & Secure cookies
# Leave blank during local HTTP testing
APP_ORIGIN=

# HMAC-SHA256 shared secret for Cloudflare Email Worker / push webhooks (auto-generated if omitted)
EMAIL_WEBHOOK_SECRET=

# Optional OpenAI-compatible LLM fallback for unknown email receipts
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Web Push VAPID keys (auto-generated and saved to SQLite if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Background poll interval (ms) for detecting posted scheduled transactions in Actual (default 300000 = 5m)
SCHEDULE_WATCH_INTERVAL_MS=300000
